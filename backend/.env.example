# Copy to backend/.env and adjust. Never commit the real .env.
FACERECALL_APP_ENV=development

# SQLite for the local prototype. PostgreSQL example:
# FACERECALL_DATABASE_URL=postgresql+psycopg://facerecall:password@localhost:5432/facerecall
FACERECALL_DATABASE_URL=sqlite:///./data/facerecall.db

# Comma-separated browser origins allowed to call the API.
FACERECALL_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where thumbnails + models live (relative to backend/ or absolute).
FACERECALL_DATA_DIR=./data
FACERECALL_MODEL_DIR=./models

# Default recognition thresholds. These are starting points, not accuracy claims.
FACERECALL_RECOGNITION_THRESHOLD=0.45
FACERECALL_AMBIGUITY_MARGIN=0.05

# Upload limits
FACERECALL_MAX_UPLOAD_BYTES=8000000
FACERECALL_MAX_IMAGE_PIXELS=20000000

# Optional at-rest encryption for stored embeddings.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to store plaintext (documented in docs/privacy.md).
FACERECALL_ENCRYPTION_KEY=

# Single-user local prototype. For a shared machine, set a long random token and
# send it as `Authorization: Bearer <token>`.
FACERECALL_API_TOKEN=

# Rate limiting (only meaningful when exposed beyond localhost).
FACERECALL_ENABLE_RATE_LIMIT=false
FACERECALL_RATE_LIMIT_PER_MINUTE=60
