# Copy to frontend/.env and adjust if your API runs elsewhere.
# Never put secrets here: anything prefixed with VITE_ is shipped to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only set this if the backend requires FACERECALL_API_TOKEN. It will be visible
# to anyone who loads the page, so prefer running the API bound to localhost.
VITE_API_TOKEN=
